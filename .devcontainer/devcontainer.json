{
    "name": "AI Course Sprint 1 (Python 3.10)",
    "image": "mcr.microsoft.com/devcontainers/python:3.10",
    
    // Указываем pip использовать кэш в домашней папке vscode
    "postCreateCommand": "pip install --cache-dir=/home/vscode/.cache/pip -r sprint1/requirements_sprint_1.txt",
    
    "forwardPorts": [8888],
    
    "mounts": [
        // Кэш pip теперь ведём в домашнюю папку vscode
        "source=${localEnv:USERPROFILE}\\.cache\\pip,target=/home/vscode/.cache/pip,type=bind,consistency=cached",
        
        "source=C:\\ai\\data,target=/data,type=bind,consistency=cached",
        "source=D:\\ai_hf\\rubert-base-cased-sentiment,target=/models/rubert-base-cased-sentiment,type=bind,consistency=cached"
    ],

    "customizations": {
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "jupyter.kernels.defaultKernelName": "python3" 
            },
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.debugpy",
                "ms-toolsai.jupyter",
                "ms-toolsai.jupyter-keymap",
                "ms-toolsai.jupyter-renderers"
            ]
        }
    }
}